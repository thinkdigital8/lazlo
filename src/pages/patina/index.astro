---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import CTASection from "../../components/CTASection.astro";
import { Image } from "astro:assets";
import { patinaFinishes, patinaMetals, patinaSizes } from "../../data/liquid-metal";
import patinaHero from "../../assets/patina/patina-hero.png";
import sampleM from "../../assets/patina/patina-sample-m0001.jpg";
import sampleT from "../../assets/patina/patina-sample-t0001.jpg";
import sampleA from "../../assets/patina/patina-sample-a0001.png";
---

<BaseLayout
  title="Antique Patina Finishes — Rusted Iron, Verdigris Copper, Antique Brass"
  description="Lazlo's handcrafted antique patina finishes on mild steel — including rusted iron, verdigris copper and antique brass — for wall panels, furniture, facades and signage."
  path="/patina/"
>
  <div class="container"><Breadcrumbs items={[{ label: "Antique Patina", href: "/patina/" }]} /></div>

  <section class="section-tight">
    <div class="container split">
      <div class="split-copy">
        <SectionHeading
          as="h1"
          eyebrow="Patina Surfaces"
          title="Instantly Vintage, Forever Classic"
          lede="Lazlo brings handcrafted patina finishes to mild steel. Patina is applied to activated metal surfaces to create a unique, mottled, artistic ambiance that varies from sheet to sheet — then sealed with a clear coat to protect against scratches, scrapes and rusting caused by environmental factors. Every pre-finished sheet is one of a kind, with high variability in colour patterning from sheet to sheet, creating a stunning spectrum of colour as the angle of view or illumination changes."
        />
      </div>
      <div class="split-media reveal">
        <Image src={patinaHero} alt="Interior with an antique patina finished feature wall" width={800} height={900} />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading eyebrow="Craft the Antique Aesthetic" title="Signature Patina Finishes" align="center" />
      <div class="grid grid-3">
        <div class="patina-card reveal">
          <div class="patina-media"><Image src={sampleM} alt="Handcrafted patina finish sample on metal sheet, showing oxidised colour variation" width={600} height={1000} /></div>
          <h3>{patinaFinishes[0].name}</h3>
          <p class="text-muted">{patinaFinishes[0].description}</p>
        </div>
        <div class="patina-card reveal">
          <div class="patina-media"><Image src={sampleT} alt="Handcrafted patina finish sample showing natural sheet-to-sheet variation" width={600} height={1000} /></div>
          <h3>{patinaFinishes[1].name}</h3>
          <p class="text-muted">{patinaFinishes[1].description}</p>
        </div>
        <div class="patina-card reveal">
          <div class="patina-media"><Image src={sampleA} alt="Handcrafted antique brass patina finish sample showing warm oxidised colour variation" width={600} height={600} /></div>
          <h3>{patinaFinishes[2].name}</h3>
          <p class="text-muted">{patinaFinishes[2].description}</p>
          <p class="note">With over 100 handcrafted finishes to choose from, we'll help you find the right patina for your space.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="split-copy">
        <SectionHeading eyebrow="Applications" title="Interior & Exterior Use" />
        <div class="app-cols">
          <div>
            <h3>Interior</h3>
            <p class="text-muted">Wall panels, ceiling panels, door skins, furniture skins, lighting fixtures, art installations.</p>
          </div>
          <div>
            <h3>Exterior</h3>
            <p class="text-muted">Facades, signage, garden installations such as fences, outdoor lighting fixtures, and sculpture installations.</p>
          </div>
        </div>
      </div>
      <div class="split-copy">
        <h3 class="h3">Available in</h3>
        <p class="text-muted" style="margin-bottom:1rem;">{patinaMetals.join(", ")}</p>
        <h3 class="h3">Standard Sizes</h3>
        <ul class="chip-list">
          {patinaSizes.map((s) => <li>{s}</li>)}
        </ul>
        <p class="text-muted" style="margin-top:1.25rem;">We provide installation services at the site for seamless integration. If you'd prefer to install the finishes yourself, we supply the necessary adhesives and tapes.</p>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading eyebrow="Beyond the Sheet" title="Custom Solutions & Installations" align="center" />
      <div class="grid grid-3 service-grid">
        <div class="service-card reveal">
          <h3>Delivery & Installation</h3>
          <p class="text-muted">We deliver and install your wall panels, doors, and ceilings.</p>
        </div>
        <div class="service-card reveal">
          <h3>Patina & Metal Effects</h3>
          <p class="text-muted">We provide job work, applying patina and metal effects on your installations according to your requirements.</p>
        </div>
        <div class="service-card reveal">
          <h3>Turnkey Furniture & Fabrication</h3>
          <p class="text-muted">We offer turnkey furniture and fabrication installations based on your design.</p>
        </div>
        <div class="service-card reveal">
          <h3>Custom Metal Work</h3>
          <p class="text-muted">We create custom-designed metalwork for any project.</p>
        </div>
        <div class="service-card reveal">
          <h3>Art Installations</h3>
          <p class="text-muted">We specialise in crafting and installing metal art pieces.</p>
        </div>
        <div class="service-card reveal">
          <h3>Architectural Metal Design</h3>
          <p class="text-muted">We provide tailored solutions for unique architectural metal requirements.</p>
        </div>
        <div class="service-card reveal">
          <h3>Site Consultation</h3>
          <p class="text-muted">We offer consultation for the design and integration of metal finishes and installations.</p>
        </div>
      </div>
      <p class="process-note reveal"><strong>Please note:</strong> The process is handmade with the help of a natural oxidation process. The pattern will not be identical, ensuring each one has its own distinct charm — however, the colour palette will remain similar.</p>
    </div>
  </section>

  <CTASection title="Bring an Aged Metal Surface to Life" lede="Share your space and substrate — we'll recommend the right patina finish and installation method." />
</BaseLayout>

<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .split-media :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-lg); aspect-ratio: 4/5; }
  .section-alt { background: var(--bg-elevated); }
  .patina-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; padding-bottom: 1.5rem; }
  .patina-card.text-card { padding: 1.75rem; display: flex; flex-direction: column; justify-content: center; }
  .patina-media { aspect-ratio: 3/4; overflow: hidden; }
  .patina-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .patina-card h3 { font-family: var(--font-display); font-size: 1.2rem; margin: 1.25rem 1.25rem 0.5rem; }
  .patina-card.text-card h3 { margin: 0 0 0.5rem; }
  .patina-card p { font-size: 0.88rem; margin-inline: 1.25rem; line-height: 1.55; }
  .patina-card.text-card p { margin-inline: 0; }
  .patina-card .note { margin-top: 1rem; font-size: 0.8rem; color: var(--text-faint); }
  .app-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1rem; }
  .app-cols h3 { font-family: var(--font-display); font-size: 1.05rem; margin-bottom: 0.5rem; }
  .chip-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip-list li { padding: 0.4em 0.85em; border: 1px solid var(--border-strong); border-radius: 999px; font-size: 0.8rem; color: var(--text-muted); }
  .service-grid { margin-top: 2.5rem; }
  .service-card { padding: 1.75rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .service-card h3 { font-family: var(--font-display); font-size: 1.1rem; margin-bottom: 0.6rem; }
  .service-card p { font-size: 0.88rem; line-height: 1.55; }
  .process-note { margin-top: 2rem; text-align: center; font-size: 0.85rem; color: var(--text-faint); max-width: 640px; margin-inline: auto; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } .app-cols { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .service-grid { grid-template-columns: 1fr; } }
</style>
