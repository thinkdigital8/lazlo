---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import CTASection from "../../../components/CTASection.astro";
import { Image } from "astro:assets";
import { aluminiumCategories, aluminiumImages } from "../../../data/aluminium";
import { site } from "../../../data/site";
---

<BaseLayout
  title="Aluminium Alloy 6063 Profiles — Material & Finish"
  description="Lazlo's aluminium profiles are manufactured from high-grade aluminium alloy 6063 with 15–20 micron anodising, in black, silver, white, mill finish or custom coating."
  path="/aluminium/profiles/"
>
  <div class="container"><Breadcrumbs items={[{ label: "Aluminium", href: "/aluminium/" }, { label: "Aluminium Profiles", href: "/aluminium/profiles/" }]} /></div>

  <section class="section-tight">
    <div class="container split">
      <div class="split-copy">
        <SectionHeading
          as="h1"
          eyebrow="The Material"
          title="Aluminium Profiles"
          lede={`Every Lazlo profile is manufactured from top-quality aluminium alloy 6063 — the same grade trusted across the sign and display industry for its strength-to-weight ratio, corrosion resistance and clean anodised finish. With ${site.yearsExperience} years of experience, we offer a complete line of innovative aluminium profile solutions for indoor and outdoor advertising.`}
        />
        <ul class="spec-list">
          <li><strong>Material:</strong> Aluminium Alloy 6063-T6</li>
          <li><strong>Anodising:</strong> 15–20 microns</li>
          <li><strong>Standard lengths:</strong> 12.25 ft (3733.8 mm) or 6.125 ft (1866.9 mm)</li>
          <li><strong>Finish options:</strong> Black, Silver, White, Mill Finish, Custom Coating</li>
        </ul>
      </div>
      <div class="split-media reveal">
        <Image src={aluminiumImages.productGroup} alt="Range of Lazlo aluminium profile cross-sections" width={800} height={700} />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <SectionHeading eyebrow="In-House Manufacturing" title="From Extrusion to Installation" align="center" />
      <div class="split reverse">
        <div class="split-media reveal">
          <Image src={aluminiumImages.workshop} alt="Aluminium sign and display fabrication in progress" width={900} height={520} />
        </div>
        <div class="split-copy">
          <p class="lede">
            Profiles are cut, finished and assembled to suit lit and non-lit configurations, single or double-sided media, and a range of installation types — wall fitting, flange, suspended, self-standing or hanging.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Browse by System" title="Profile Categories" align="center" />
      <ul class="category-links">
        {aluminiumCategories.map((cat) => (
          <li><a href={`/aluminium/${cat.slug}/`}>{cat.name} <span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <CTASection title="Need a Specific Profile Spec?" lede="Share your project details and we'll help you choose the right profile, finish and installation type." />
</BaseLayout>

<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .split.reverse .split-media { order: 1; }
  .split.reverse .split-copy { order: 2; }
  .split-media :global(img) { width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-lg); aspect-ratio: 16/10; }
  .section-alt { background: var(--bg-elevated); }
  .spec-list { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .spec-list li { font-size: 0.92rem; color: var(--text-muted); }
  .spec-list strong { color: var(--text); }
  .category-links { max-width: 560px; margin-inline: auto; display: flex; flex-direction: column; gap: 0.5rem; }
  .category-links a { display: flex; justify-content: space-between; padding: 1rem 1.25rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); text-decoration: none; color: var(--text); font-size: 0.95rem; transition: border-color 0.25s var(--ease), color 0.25s var(--ease); }
  .category-links a:hover { border-color: var(--accent); color: var(--accent-bright); }
  @media (max-width: 900px) { .split, .split.reverse { grid-template-columns: 1fr; } .split.reverse .split-media, .split.reverse .split-copy { order: 0; } }
</style>
