---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ContactForm from "../../components/ContactForm.astro";
import { site } from "../../data/site";
---

<BaseLayout
  title="Contact Lazlo — Discuss Your Project"
  description="Get in touch with Lazlo for Liquid Metal finishes, antique patina, chrome spray finishes or aluminium profile systems. Call +91 95588 09753 or email info@lazloindia.com."
  path="/contact/"
>
  <div class="container"><Breadcrumbs items={[{ label: "Contact", href: "/contact/" }]} /></div>

  <section class="section-tight">
    <div class="container">
      <SectionHeading as="h1" eyebrow="Get in Touch" title="Discuss Your Project" align="center" lede="Whether it's a Liquid Metal feature wall, an antique patina surface, a chrome finish object or an aluminium signage system — tell us about it." />
    </div>
  </section>

  <section class="section contact-section">
    <div class="container contact-grid">
      <div class="contact-info reveal">
        <div class="info-block">
          <h3>Phone</h3>
          <a href={site.phoneHref}>{site.phone}</a>
        </div>
        <div class="info-block">
          <h3>Email</h3>
          <a href={site.emailHref}>{site.email}</a>
        </div>
        <div class="info-block">
          <h3>{site.addresses.office.label}</h3>
          <p>{site.addresses.office.lines.map((l) => <>{l}<br /></>)}</p>
          <a href={site.addresses.office.mapUrl} target="_blank" rel="noopener noreferrer" class="map-link">Get Directions →</a>
        </div>
        <div class="info-block">
          <h3>{site.addresses.workshop.label}</h3>
          <p>{site.addresses.workshop.lines.map((l) => <>{l}<br /></>)}</p>
          <a href={site.addresses.workshop.mapUrl} target="_blank" rel="noopener noreferrer" class="map-link">Get Directions →</a>
        </div>
        <div class="info-block">
          <h3>Follow</h3>
          <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>

      <div class="contact-form-wrap reveal">
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="map-embed reveal">
        <iframe
          title="Lazlo office location map"
          src="https://www.google.com/maps?q=23.0512066,72.4800139&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.4fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .info-block h3 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .info-block a {
    color: var(--text);
    text-decoration: none;
    font-size: 1rem;
  }

  .info-block a:hover {
    color: var(--accent-bright);
  }

  .info-block p {
    color: var(--text-muted);
    line-height: 1.6;
    font-size: 0.92rem;
  }

  .map-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--accent);
  }

  .contact-form-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .map-embed {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .map-embed iframe {
    width: 100%;
    height: 420px;
    border: 0;
    filter: grayscale(0.3) invert(0.92) contrast(0.9);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
