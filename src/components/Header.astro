---
import { site, nav } from "../data/site";
import logo from "../assets/brand/lazlo-logo-light.png";
import { Image } from "astro:assets";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header class="site-header" id="site-header">
  <div class="container bar">
    <a href="/" class="logo" aria-label="Lazlo — Home">
      <Image src={logo} alt="Lazlo — Real Metal Finishes &amp; Aluminium Profiles" width={168} height={35} loading="eager" />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li class:list={["nav-item", { "has-children": "children" in item }]}>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
              {"children" in item && (
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
            {"children" in item && (
              <ul class="submenu">
                {item.children!.map((child) => (
                  <li><a href={child.href}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="cta-group">
      <a href="/contact/" class="btn btn-primary">Discuss Your Project</a>
    </div>

    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav aria-label="Mobile">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
            {"children" in item && (
              <ul class="mobile-submenu">
                {item.children!.map((child) => (
                  <li><a href={child.href}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="mobile-cta">
        <a href="/contact/" class="btn btn-primary">Discuss Your Project</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  const onScroll = () => {
    if (window.scrollY > 24) {
      header?.classList.add("scrolled");
    } else {
      header?.classList.remove("scrolled");
    }
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  toggle?.addEventListener("click", () => {
    const isOpen = document.body.classList.toggle("menu-open");
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      document.body.classList.remove("menu-open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: linear-gradient(to bottom, rgba(11, 11, 13, 0.85), rgba(11, 11, 13, 0));
    backdrop-filter: blur(6px);
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease), box-shadow 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .site-header.scrolled {
    background: rgba(11, 11, 13, 0.92);
    border-bottom-color: var(--border);
    box-shadow: 0 1px 0 rgba(237, 28, 36, 0.25), 0 20px 40px -24px rgba(0, 0, 0, 0.6);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 76px;
  }

  .logo {
    flex-shrink: 0;
    line-height: 0;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    transition: opacity 0.25s var(--ease);
  }

  .logo:hover {
    opacity: 0.85;
  }

  .logo :global(img) {
    height: 30px;
    width: auto;
  }

  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-item {
    position: relative;
  }

  .nav-item > a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--text);
    padding-block: 1.7rem;
    white-space: nowrap;
  }

  .nav-item > a::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.15rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }

  .nav-item > a[aria-current="page"] {
    color: var(--accent-bright);
  }

  .nav-item > a[aria-current="page"]::before,
  .nav-item > a:hover::before {
    transform: scaleX(1);
  }

  .nav-item > a:hover {
    color: var(--accent-bright);
  }

  .submenu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, 8px);
    min-width: 220px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }

  .nav-item.has-children:hover .submenu,
  .nav-item.has-children:focus-within .submenu {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .submenu li a {
    display: block;
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .submenu li a:hover {
    background: var(--surface-2);
    color: var(--accent-bright);
  }

  .cta-group {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .phone-link {
    text-decoration: none;
    font-size: 0.85rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .phone-link:hover {
    color: var(--accent-bright);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--text);
    margin-inline: auto;
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }

  body.menu-open .menu-toggle span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  body.menu-open .menu-toggle span:nth-child(2) {
    opacity: 0;
  }
  body.menu-open .menu-toggle span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 76px;
    left: 0;
    right: 0;
    height: calc(100vh - 76px);
    height: calc(100dvh - 76px);
    background: var(--bg-elevated);
    overflow-y: auto;
    z-index: 99;
  }

  body.menu-open .mobile-menu {
    display: block;
  }

  .mobile-menu nav {
    padding: 1.5rem var(--gutter) 3rem;
  }

  .mobile-menu > nav > ul > li {
    border-bottom: 1px solid var(--border);
  }

  .mobile-menu > nav > ul > li > a {
    display: block;
    padding: 1rem 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    text-decoration: none;
    color: var(--text);
  }

  .mobile-submenu {
    padding-bottom: 0.75rem;
  }

  .mobile-submenu li a {
    display: block;
    padding: 0.5rem 0 0.5rem 1rem;
    text-decoration: none;
    color: var(--text-muted);
    font-size: 0.95rem;
    border-left: 1px solid var(--border-strong);
  }

  .mobile-submenu li a:hover {
    color: var(--accent-bright);
  }

  .mobile-cta {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  @media (max-width: 1180px) {
    .primary-nav ul {
      gap: 1.1rem;
    }
    .nav-item > a {
      font-size: 0.82rem;
    }
    .cta-group {
      gap: 1rem;
    }
  }

  @media (max-width: 980px) {
    .primary-nav,
    .cta-group {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }
</style>
