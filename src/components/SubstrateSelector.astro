---
import { substrateDetails } from "../data/liquid-metal";
---

<div class="substrate-selector">
  <div class="substrate-tabs" role="tablist" aria-label="Suitable substrates">
    {substrateDetails.map((s, i) => (
      <button
        class="substrate-tab"
        role="tab"
        id={`tab-${s.texture}`}
        aria-controls={`panel-${s.texture}`}
        aria-selected={i === 0 ? "true" : "false"}
        data-texture={s.texture}
        data-index={i}
      >
        {s.name}
      </button>
    ))}
  </div>

  <div class="substrate-display">
    {substrateDetails.map((s, i) => (
      <div
        class="substrate-panel"
        id={`panel-${s.texture}`}
        role="tabpanel"
        aria-labelledby={`tab-${s.texture}`}
        data-panel={s.texture}
        hidden={i !== 0}
      >
        <div class={`material-chip texture-${s.texture}`} aria-hidden="true">
          <span class="chip-sheen"></span>
        </div>
        <div class="substrate-copy">
          <p class="substrate-name">{s.name}</p>
          <p class="substrate-desc text-muted">{s.description}</p>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".substrate-tab");
  const panels = document.querySelectorAll<HTMLElement>(".substrate-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const texture = tab.dataset.texture;

      tabs.forEach((t) => t.setAttribute("aria-selected", "false"));
      tab.setAttribute("aria-selected", "true");

      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== texture;
      });
    });

    tab.addEventListener("keydown", (e) => {
      const list = Array.from(tabs);
      const idx = list.indexOf(tab);
      let next: number | null = null;
      if (e.key === "ArrowRight") next = (idx + 1) % list.length;
      if (e.key === "ArrowLeft") next = (idx - 1 + list.length) % list.length;
      if (next !== null) {
        e.preventDefault();
        list[next].focus();
        list[next].click();
      }
    });
  });
</script>

<style>
  .substrate-selector {
    max-width: 900px;
    margin-inline: auto;
  }

  .substrate-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .substrate-tab {
    padding: 0.55em 1.3em;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text-muted);
    font-size: 0.88rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease), background 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }

  .substrate-tab:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .substrate-tab[aria-selected="true"] {
    background: linear-gradient(135deg, var(--accent-mid), var(--accent-deep) 75%);
    border-color: transparent;
    color: #fff6f5;
    box-shadow: 0 8px 20px -8px rgba(237, 28, 36, 0.55);
  }

  .substrate-panel {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2rem;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
  }

  .substrate-panel[hidden] {
    display: none;
  }

  .material-chip {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 16px 32px -14px rgba(0, 0, 0, 0.55), inset 0 0 0 1px rgba(255, 255, 255, 0.08);
  }

  .chip-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.22) 0%, transparent 30%, transparent 70%, rgba(0, 0, 0, 0.18) 100%);
    pointer-events: none;
  }

  .substrate-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }

  .substrate-desc {
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* ---- Material textures ---- */

  .texture-wood {
    background:
      repeating-linear-gradient(
        95deg,
        rgba(60, 32, 14, 0.35) 0px,
        rgba(60, 32, 14, 0.35) 1px,
        transparent 2px,
        transparent 7px
      ),
      linear-gradient(100deg, #8a5a34, #a97341 35%, #7c4d2b 65%, #96683d);
  }

  .texture-steel {
    background:
      repeating-linear-gradient(
        100deg,
        rgba(255, 255, 255, 0.06) 0px,
        rgba(255, 255, 255, 0.06) 1px,
        transparent 2px,
        transparent 4px
      ),
      linear-gradient(135deg, #8b9096, #6a6f75 40%, #52565b 70%, #7d8288);
  }

  .texture-glass {
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.4) 0%, rgba(190, 220, 230, 0.15) 35%, rgba(140, 180, 195, 0.25) 60%, rgba(255, 255, 255, 0.3) 100%),
      linear-gradient(160deg, #cfe6ec, #9fbfc9 60%, #b9d3da);
  }

  .texture-frp {
    background:
      repeating-linear-gradient(45deg, rgba(0, 0, 0, 0.06) 0px, rgba(0, 0, 0, 0.06) 2px, transparent 3px, transparent 7px),
      repeating-linear-gradient(-45deg, rgba(0, 0, 0, 0.05) 0px, rgba(0, 0, 0, 0.05) 2px, transparent 3px, transparent 7px),
      linear-gradient(135deg, #e7e2d6, #d8d2c2 50%, #ece7db);
  }

  .texture-plastic {
    background:
      radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.5), transparent 45%),
      linear-gradient(145deg, #d6d8db, #aeb2b8 55%, #c4c7cc);
  }

  .texture-mdf {
    background-image:
      radial-gradient(circle at 20% 30%, rgba(90, 60, 30, 0.18) 0, rgba(90, 60, 30, 0.18) 1px, transparent 1.5px),
      radial-gradient(circle at 60% 70%, rgba(90, 60, 30, 0.15) 0, rgba(90, 60, 30, 0.15) 1px, transparent 1.5px),
      radial-gradient(circle at 80% 20%, rgba(90, 60, 30, 0.15) 0, rgba(90, 60, 30, 0.15) 1px, transparent 1.5px),
      radial-gradient(circle at 40% 85%, rgba(90, 60, 30, 0.15) 0, rgba(90, 60, 30, 0.15) 1px, transparent 1.5px),
      linear-gradient(135deg, #c9a877, #b8935f 60%, #cba97a);
    background-size: 14px 14px, 18px 18px, 16px 16px, 20px 20px, 100% 100%;
  }

  .texture-acp {
    background:
      repeating-linear-gradient(
        100deg,
        rgba(255, 255, 255, 0.08) 0px,
        rgba(255, 255, 255, 0.08) 1px,
        transparent 2px,
        transparent 5px
      ),
      linear-gradient(135deg, #c7ccd1, #9ea3a9 45%, #babfc4 75%, #d3d7db);
  }

  .texture-concrete {
    background:
      radial-gradient(circle at 25% 30%, rgba(0, 0, 0, 0.12) 0, transparent 8%),
      radial-gradient(circle at 70% 60%, rgba(0, 0, 0, 0.1) 0, transparent 10%),
      radial-gradient(circle at 40% 80%, rgba(255, 255, 255, 0.08) 0, transparent 9%),
      radial-gradient(circle at 85% 20%, rgba(0, 0, 0, 0.1) 0, transparent 7%),
      linear-gradient(150deg, #9a9a96, #83837f 55%, #8f8f8b);
  }

  .texture-korean {
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.55) 0%, transparent 30%),
      linear-gradient(140deg, #f1efe9, #ded9ce 60%, #eeece5);
  }

  @media (max-width: 640px) {
    .substrate-panel {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }
</style>
